APP_NAME="KlinikForm SIMRS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=klinikform
DB_USERNAME=simrs
DB_PASSWORD=simrs_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@klinikform.local"
MAIL_FROM_NAME="KlinikForm SIMRS"

TELESCOPE_ENABLED=true
TELESCOPE_DRIVER=database
TELESCOPE_DOMAIN=localhost

# ---------------------------------------------------------------------------
# KlinikForm SIMRS secrets. Injected by environment only; never committed.
# Generate with: php artisan klinikform:pepper
# ---------------------------------------------------------------------------
BLIND_INDEX_PEPPER=

# Bearer token guarding the SatuSehat FHIR gateway (/api/v1/fhir/*).
FAPI_TOKEN=

# Requests/minute allowed per interoperability credential. Raise it only for
# the staging load profiles (tests/Performance); production keeps the default.
INTEROP_RATE_LIMIT_PER_MINUTE=600

# BPJS Kesehatan VClaim simulator credentials.
BPJS_CONS_ID=1234567890
BPJS_SECRET_KEY=0123456789abcdef0123456789abcdef
BPJS_USER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BPJS_FASKES_CODE=0301R001